{
  "screen": "ArmyPanelB",
  "startsHidden": true,

  "background": { "sprite": "armypanel.png", "fit": "cover" },

  "groups": [
    {
      "name": "Header",
      "elements": [
        {
          "type": "label", "name": "ArmyTitle", "text": "Your Company",
          "font": "head", "size": 50, "color": "gold", "align": "center",
          "rect": { "top": 0.030, "height": 0.038, "left": 0.06, "right": 0.06 }
        },
        {
          "type": "image", "name": "HeaderStrip", "tint": "#140D06BF",
          "rect": { "top": 0.078, "height": 0.070, "left": 0.05, "right": 0.05 }
        },
        {
          "type": "label", "name": "UpkeepLine",
          "font": "body", "size": 30, "color": "cream", "align": "center",
          "rect": { "top": 0.088, "height": 0.026, "left": 0.07, "right": 0.07 }
        },
        {
          "type": "label", "name": "StrengthLine",
          "font": "body", "size": 25, "color": "cream", "align": "center",
          "rect": { "top": 0.118, "height": 0.024, "left": 0.07, "right": 0.07 }
        }
      ]
    },

    {
      "name": "Roster",
      "elements": [
        {
          "type": "label", "name": "RosterHeading", "text": "COMPANY",
          "font": "head", "size": 30, "color": "gold", "align": "left",
          "rect": { "top": 0.163, "height": 0.024, "left": 0.07, "right": 0.07 }
        },
        {
          "type": "scroll", "name": "RosterScroll",
          "spacing": 16,
          "padding": { "left": 0, "right": 0, "top": 0, "bottom": 24 },
          "templateSprite": "NEE/AmptyLongButton2.png",
          "templateHorizontal": true,
          "templateMinHeight": 0.095,
          "templatePadding": { "left": 26, "right": 30, "top": 16, "bottom": 16 },
          "template": [
            { "type": "image", "name": "Portrait", "sprite": "Soldier Icons/PoorSoldier.png", "width": 0.095 },
            { "type": "label", "name": "UnitName",   "role": "title",   "font": "head", "size": 34, "color": "ink",      "align": "left" },
            { "type": "label", "name": "UnitUpkeep", "role": "subtext", "font": "body", "size": 24, "color": "ink-soft", "align": "right", "width": 0.20 },
            { "type": "label", "name": "UnitCount",  "font": "head", "size": 36, "color": "ink", "align": "right", "width": 0.09 }
          ],
          "rect": { "top": 0.195, "bottom": 0.300, "left": 0.05, "right": 0.05 }
        }
      ]
    },

    {
      "name": "Selected",
      "elements": [
        {
          "type": "image", "name": "DetailStrip", "tint": "#140D06D9",
          "rect": { "vanchor": "bottom", "bottom": 0.130, "height": 0.160, "left": 0.05, "right": 0.05 }
        },
        {
          "type": "label", "name": "DetailName",
          "font": "head", "size": 36, "color": "gold", "align": "left",
          "rect": { "vanchor": "bottom", "bottom": 0.248, "height": 0.030, "left": 0.08, "right": 0.08 }
        },
        {
          "type": "label", "name": "DetailBody",
          "font": "body", "size": 25, "color": "cream", "align": "topleft",
          "rect": { "vanchor": "bottom", "bottom": 0.150, "height": 0.090, "left": 0.08, "right": 0.08 }
        }
      ]
    },

    {
      "name": "Actions",
      "elements": [
        {
          "type": "button", "name": "RecruitButton", "label": "Recruit",
          "font": "head", "size": 30, "color": "cream",
          "sprite": "NEE/AmptyLongButton2.png", "fit": "slice",
          "rect": { "vanchor": "bottom", "bottom": 0.060, "height": 0.052, "width": 0.27, "anchor": "left", "left": 0.06 }
        },
        {
          "type": "button", "name": "PromoteButton", "label": "Promote",
          "font": "head", "size": 30, "color": "cream",
          "sprite": "NEE/AmptyLongButton2.png", "fit": "slice",
          "rect": { "vanchor": "bottom", "bottom": 0.060, "height": 0.052, "width": 0.27, "anchor": "center" }
        },
        {
          "type": "button", "name": "DisbandButton", "label": "Disband",
          "font": "head", "size": 30, "color": "cream",
          "sprite": "NEE/AmptyLongButton2.png", "fit": "slice",
          "rect": { "vanchor": "bottom", "bottom": 0.060, "height": 0.052, "width": 0.27, "anchor": "right", "right": 0.06 }
        },
        {
          "type": "button", "name": "BackButton",
          "sprite": "Buttons/R BUTTON.png", "fit": "fit",
          "rect": { "vanchor": "bottom", "bottom": 0.006, "height": 0.044, "width": 0.14, "anchor": "left", "left": 0.05 }
        }
      ]
    }
  ]
}
